        "\n",
        "## Add as you go\n",
        "\n",
        "- We may set a variable to an expression *over that variable*\n",
        "    - I think of this as an \"old\" version of the variable on the right side of the equal sign.\n",
        "\n",
        ":::: {.columns}\n",
        "\n",
        "::: {.column width=\"50%\"}\n"
      ],
      "id": "368e8032"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "x = .10 * 9275\n",
        "x = x + .15 * (37650 - 9275)\n",
        "x = x + .25 * (91150 - 37650)\n",
        "x = x + .28 * (190150 - 91150)\n",
        "x + .33 * (400000 - 190150)"
      ],
      "id": "65f6902f",
      "execution_count": null,
      "outputs": []
    },
