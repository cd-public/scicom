      "source": [
        "plt.plot(incomes, costs / incomes * 100, label = \"Tax Rate\", color=\"blue\")\n",
        "plt.plot(incomes, brackets, label=\"Marginal Rate\", color=\"red\")\n",
        "plt.legend()"
      ],
