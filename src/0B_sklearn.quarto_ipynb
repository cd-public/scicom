        "\n",
        "\n",
        "## It's a zero \n",
        "\n",
        ":::: {.columns}\n",
        "\n",
        "::: {.column width=\"50%\"}\n"
      ],
      "id": "0c5e4251"
    },
    {
      "cell_type": "code",
